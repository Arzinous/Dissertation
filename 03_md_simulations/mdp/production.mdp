; production.mdp — 10 ns unrestrained production
; Built directly from the ACTUAL npt.mdp used in this project (verified by
; direct diff, not guessed), with -DPOSRES removed and run length extended.

; Production: 10 ns, unrestrained
define                  =                 ; NO position restraints
integrator              = md
dt                      = 0.002
nsteps                  = 5000000         ; 10 ns at dt = 0.002 ps
continuation            = yes

; Output — trajectory every 10 ps (1000 frames over 10 ns); energy/log every 1 ps
; (nstxout-compressed widened vs npt.mdp's 500/1ps -- 10 ns at 1ps/frame would be
;  10,000 frames, unnecessarily large for equilibrium analysis; adjust back to
;  500 if you specifically want 1 ps resolution instead)
nstxout                  = 0
nstvout                  = 0
nstfout                  = 0
nstxout-compressed       = 5000
nstenergy                = 500
nstlog                   = 500
nstcalcenergy            = 100

; Bond constraints — identical to npt.mdp
constraint-algorithm     = lincs
constraints               = h-bonds
lincs-iter               = 1
lincs-order               = 4

; Neighbour searching — identical to npt.mdp
cutoff-scheme            = Verlet
nstlist                  = 20
rlist                    = 1.2

; Electrostatics — identical to npt.mdp
coulombtype              = PME
rcoulomb                 = 1.2

; Van der Waals — identical to npt.mdp
vdwtype                  = Cut-off
rvdw                     = 1.2
DispCorr                 = EnerPres

; Temperature coupling — identical to npt.mdp
tcoupl                   = V-rescale
tc-grps                  = Protein non-Protein
tau-t                    = 0.1 0.1
ref-t                    = 300 300

; Pressure coupling — identical to npt.mdp
pcoupl                   = C-rescale
pcoupltype               = isotropic
tau-p                    = 2.0
ref-p                    = 1.0
compressibility          = 4.5e-5
refcoord-scaling         = com          ; harmless with define empty (no restraints)

; Continue existing velocities from npt.cpt
gen-vel                  = no

comm-mode                = Linear
nstcomm                  = 100
pbc                      = xyz
