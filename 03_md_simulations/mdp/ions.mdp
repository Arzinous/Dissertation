; Minimal preprocessing configuration for ion placement
integrator              = steep
emtol                   = 1000.0
emstep                  = 0.01
nsteps                  = 5000

cutoff-scheme           = Verlet
nstlist                 = 20
rlist                   = 1.2

coulombtype             = PME
rcoulomb                = 1.2

vdwtype                 = Cut-off
rvdw                    = 1.2
DispCorr                = EnerPres

constraints             = none
pbc                     = xyz
