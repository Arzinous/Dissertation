; NVT equilibration: 100 ps at 300 K
define                  = -DPOSRES
integrator              = md
dt                      = 0.002
nsteps                  = 50000
continuation            = no

; Output
nstxout                  = 0
nstvout                  = 0
nstfout                  = 0
nstxout-compressed       = 500
nstenergy                = 500
nstlog                   = 500
nstcalcenergy            = 100

; Bond constraints
constraint-algorithm     = lincs
constraints              = h-bonds
lincs-iter               = 1
lincs-order              = 4

; Neighbour searching
cutoff-scheme            = Verlet
nstlist                  = 20
rlist                    = 1.2

; Electrostatics
coulombtype              = PME
rcoulomb                 = 1.2

; Van der Waals
vdwtype                  = Cut-off
rvdw                     = 1.2
DispCorr                 = EnerPres

; Temperature coupling
tcoupl                   = V-rescale
tc-grps                  = Protein non-Protein
tau-t                    = 0.1 0.1
ref-t                    = 300 300

; No pressure coupling
pcoupl                   = no

; Generate initial velocities
gen-vel                  = yes
gen-temp                 = 300
gen-seed                 = -1

comm-mode                = Linear
nstcomm                  = 100
pbc                      = xyz
