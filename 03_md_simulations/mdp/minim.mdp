; Energy minimisation
integrator              = steep
emtol                   = 1000.0
emstep                  = 0.01
nsteps                  = 50000

; Output
nstenergy               = 100
nstlog                  = 100

; Neighbour searching
cutoff-scheme           = Verlet
nstlist                 = 20
rlist                   = 1.2

; Electrostatics
coulombtype             = PME
rcoulomb                = 1.2

; Van der Waals: Amber-compatible cutoff treatment
vdwtype                 = Cut-off
rvdw                    = 1.2
DispCorr                = EnerPres

constraints             = none
pbc                     = xyz
